# ─────────────────────────────────────────────────────────────────────────────
# EpitopX AI — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me-generate-a-real-secret-key

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
FRONTEND_URL=http://localhost:3333

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://epitopx:epitopx2024@localhost:5432/backend_db
# Or individual vars for docker-compose:
POSTGRES_DB=epitopx_db
POSTGRES_USER=epitopx
POSTGRES_PASSWORD=epitopx2024

# ── Redis (optional — falls back to local-memory cache if unset) ─────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT tokens ───────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ── Email ─────────────────────────────────────────────────────────────────────
# For development, use the console backend (prints emails to stdout):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, switch to SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=EpitopX <noreply@epitopx.ai>

# ── Frontend (Node.js proxy) ──────────────────────────────────────────────────
PORT=3333
REMOTE_API=http://localhost:8000
EPITOPE_API=http://localhost:8000
LOG_LEVEL=info

# ── Optional: LLM integration ────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=openrouter
