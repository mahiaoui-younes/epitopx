# ═══════════════════════════════════════════════════════════════════
#  EpitopX AI — Local Development Configuration
#  Copy this file to .env and fill in your values.
#  Edit this file, then restart the Node server (node server.js)
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
PORT=3333
LOG_LEVEL=info

# ── Backend API (Django) ─────────────────────────────────────────────
REMOTE_API=http://localhost:8000
EPITOPE_API=http://localhost:8000

# ── LLM Provider ────────────────────────────────────────────────────
# Options: pollinations | groq | openai | gemini | anthropic | openrouter | ollama
#
# pollinations → FREE, no key, no signup — just works!
LLM_PROVIDER=openrouter

# ── API Key ─────────────────────────────────────────────────────────
# OpenRouter → https://openrouter.ai/keys
LLM_API_KEY=sk-or-v1-your-key-here

# ── Model override (optional) ────────────────────────────────────────
# Leave blank to use the default model for the chosen provider.
# Paid tier — no rate limits from the free tier
LLM_MODEL=openai/gpt-oss-120b
