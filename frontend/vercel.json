{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html,css/**,js/**,lib/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
