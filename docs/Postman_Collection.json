      "name": "Conversions",
      "item": [
        {
          "name": "Convert DNA to RNA to Protein",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dna_sequence\": \"ATGATGATGATG\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/conversions/convert/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "conversions",
                "convert",
                ""
              ]
            },
            "description": "Convertir une séquence ADN en ARN et Protéine"
          },
          "response": []
        },
