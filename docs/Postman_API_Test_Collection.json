    {
      "name": "🧬 PROTEINS - LIST & CREATE",
      "item": [
        {
          "name": "LIST All Proteins (Filtered by Role)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token YOUR_TOKEN_HERE"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/proteins/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "proteins",
                ""
              ]
            },
            "description": "List proteins based on user role:\n\n**If User:**\n- See: public proteins + own proteins\n- Count: ~6 (4 public + 2 own)\n\n**If Admin:**\n- See: ALL proteins (public + private)\n- Count: ~13 (all)\n\n**Status Expected:**\n- 200: Success\n- 401: Unauthorized"
          },
          "response": []
        },
