          "name": "UPDATE Protein - Owner Only",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Token YOUR_TOKEN_HERE"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"UpdatedProteinName\",\n  \"sequence\": \"MVSKQSLLWNTFTPPLLLSGLLGWFQAKSDSAVEGVQVKVKALPDAQFEVV\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/proteins/1/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "proteins",
                "1",
                ""
              ]
            },
            "description": "Update a protein (owner or admin only)\n\n**If You Own It:**\n- Status: 200 OK\n- Update successful\n\n**If Not Owner & Not Admin:**\n- Status: 403 Forbidden\n- Access denied\n\n**Replace 1 with actual protein ID**"
          },
          "response": []
        },
        {
          "name": "DELETE Protein - Owner Only",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token YOUR_TOKEN_HERE"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/proteins/1/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "proteins",
                "1",
                ""
              ]
            },
            "description": "Delete a protein (owner or admin only)\n\n**If You Own It:**\n- Status: 204 No Content\n- Protein deleted\n\n**If Not Owner & Not Admin:**\n- Status: 403 Forbidden\n- Access denied\n\n**Replace 1 with actual protein ID**"
          },
          "response": []
        }
      ]
