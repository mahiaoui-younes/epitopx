              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"password_confirm\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/users/register/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "api",
                "users",
                "register",
                ""
              ]
            },
            "description": "Create a new user account\n\n**Status Expected:**\n- 201: User created successfully\n- 400: Username already exists or password mismatch"
          },
          "response": []
