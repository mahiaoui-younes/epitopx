        {
          "name": "[6] ADMIN: All Proteins",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Token ADMIN_TOKEN_HERE"}],
            "url": {
              "raw": "http://localhost:8000/api/proteins/all_proteins/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "proteins", "all_proteins", ""]
            },
            "description": "Step 6: See ALL proteins as admin\n✅ See: EVERYTHING (public + private)\n✅ If not admin → 403 Forbidden"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api"},
