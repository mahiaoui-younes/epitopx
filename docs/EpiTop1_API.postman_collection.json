              "raw": "{\n  \"sequence\": \"MFVFLVLLPLVSSTQWFVFLVLLPLVSSTQWFVFLVLLPLVSSTQ\",\n  \"method\": \"core\",\n  \"min_length\": 9,\n  \"max_length\": 20,\n  \"min_score\": 0.5,\n  \"top_n\": 20\n}"
