# ── Django backend environment variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Security ────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
# Local: localhost,127.0.0.1
# Production: .onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────
# Option A — PostgreSQL via URL (Render sets this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — Local MySQL (leave DATABASE_URL unset)
DB_NAME=backend_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Also install locally: pip install mysqlclient

# ── CORS ──────────────────────────────────────────────────────────────────
# URL of the deployed Node.js frontend (Render URL after deploying frontend)
# FRONTEND_URL=https://epitopx-frontend.onrender.com
